@{
    ViewData["Title"] = "Error";
    Layout = "_Layout";
}

<div class="d-flex flex-column align-items-center justify-content-center text-center" style="min-height:60vh;">
    <i class="bi bi-exclamation-octagon text-danger" style="font-size:4rem;"></i>
    <h2 class="mt-3">Something went wrong</h2>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>
    <a href="/" class="btn btn-primary mt-2">Go to Home</a>
</div>
