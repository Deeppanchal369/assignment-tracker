@{
    var userRole = Context.Session.GetString("UserRole");
    var userName = Context.Session.GetString("UserName");
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Assignment Submission Tracker</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark app-navbar fixed-top">
        <div class="container-fluid">
            <a class="navbar-brand fw-semibold" href="/">
                <i class="bi bi-journal-check me-2"></i>Assignment Submission Tracker
            </a>
            <button class="navbar-toggler d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarOffcanvas">
                <span class="navbar-toggler-icon"></span>
            </button>
            @if (!string.IsNullOrEmpty(userRole))
            {
                <div class="d-flex align-items-center ms-auto text-white">
                    <span class="me-3 d-none d-sm-inline">
                        <i class="bi bi-person-circle me-1"></i>@userName <span class="badge bg-light text-primary ms-1">@userRole</span>
                    </span>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-light btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i>Logout
                    </a>
                </div>
            }
        </div>
    </nav>

    <div class="app-body">
        @if (!string.IsNullOrEmpty(userRole))
        {
            <div class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="sidebarOffcanvas">
                <div class="offcanvas-body d-flex flex-column p-0">
                    <ul class="nav flex-column app-nav">
                        @if (userRole == "Teacher")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Teacher" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Teacher" asp-action="Assignments"><i class="bi bi-journal-text me-2"></i>Assignments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Teacher" asp-action="CreateAssignment"><i class="bi bi-plus-circle me-2"></i>Create Assignment</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Teacher" asp-action="LateSubmissions"><i class="bi bi-exclamation-triangle me-2"></i>Late Submissions</a>
                            </li>
                        }
                        else if (userRole == "Student")
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Assignments"><i class="bi bi-journal-text me-2"></i>Assignments</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Student" asp-action="Marks"><i class="bi bi-award me-2"></i>Marks &amp; Remarks</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        }

        <main class="app-content @(string.IsNullOrEmpty(userRole) ? "app-content-full" : "")">
            <div class="container-fluid py-4">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show" role="alert">
                        @TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show" role="alert">
                        @TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>
        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
