@model List<Assignment>
@{
    ViewData["Title"] = "Assignments";
    int page = (int)(ViewBag.Page ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    string search = ViewBag.Search as string;
    int studentId = (int)(ViewBag.StudentId ?? 0);
}

<h4 class="mb-3">Assignments</h4>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-8">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by title or subject..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Search</button>
            </div>
            <div class="col-md-2">
                <a asp-controller="Student" asp-action="Assignments" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Subject</th>
                        <th>Due Date</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No assignments found.</td></tr>
                    }
                    @foreach (var a in Model)
                    {
                        var submission = a.Submissions.FirstOrDefault(s => s.StudentId == studentId);
                        var pastDue = DateTime.Today > a.DueDate;
                        <tr>
                            <td>@a.Title</td>
                            <td>@a.Subject</td>
                            <td>@a.DueDate.ToString("dd MMM yyyy")</td>
                            <td>
                                @if (submission == null)
                                {
                                    <span class="badge bg-secondary">Not Submitted</span>
                                }
                                else if (submission.IsLate)
                                {
                                    <span class="badge badge-late">Submitted Late</span>
                                }
                                else
                                {
                                    <span class="badge badge-ontime">Submitted</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-controller="Student" asp-action="DownloadAssignmentFile" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-primary" title="Download Assignment"><i class="bi bi-download"></i></a>
                                @if (submission == null)
                                {
                                    <a asp-controller="Student" asp-action="Submit" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-primary"><i class="bi bi-upload me-1"></i>Submit</a>
                                }
                                else if (!pastDue)
                                {
                                    <a asp-controller="Student" asp-action="Submit" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-warning"><i class="bi bi-arrow-repeat me-1"></i>Replace</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-controller="Student" asp-action="Assignments" asp-route-page="@i" asp-route-search="@search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
