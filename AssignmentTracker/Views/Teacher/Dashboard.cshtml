@model TeacherDashboardViewModel
@{
    ViewData["Title"] = "Teacher Dashboard";
}

<h3 class="mb-4">Welcome back, @Context.Session.GetString("UserName")</h3>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-blue">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Total Students</div>
                    <div class="fs-3 fw-bold">@Model.TotalStudents</div>
                </div>
                <i class="bi bi-people stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-teal">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Total Assignments</div>
                    <div class="fs-3 fw-bold">@Model.TotalAssignments</div>
                </div>
                <i class="bi bi-journal-text stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-orange">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Pending Submissions</div>
                    <div class="fs-3 fw-bold">@Model.PendingSubmissions</div>
                </div>
                <i class="bi bi-hourglass-split stat-icon"></i>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-sm-6">
        <div class="card stat-card bg-red">
            <div class="card-body d-flex justify-content-between align-items-center">
                <div>
                    <div class="small text-white-50">Late Submissions</div>
                    <div class="fs-3 fw-bold">@Model.LateSubmissions</div>
                </div>
                <i class="bi bi-exclamation-triangle stat-icon"></i>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        Recent Assignments
        <a asp-controller="Teacher" asp-action="CreateAssignment" class="btn btn-primary btn-sm">
            <i class="bi bi-plus-circle me-1"></i>New Assignment
        </a>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Subject</th>
                        <th>Due Date</th>
                        <th>Submissions</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.RecentAssignments.Any())
                    {
                        <tr><td colspan="5" class="text-center text-muted py-4">No assignments yet.</td></tr>
                    }
                    @foreach (var a in Model.RecentAssignments)
                    {
                        <tr>
                            <td>@a.Title</td>
                            <td>@a.Subject</td>
                            <td>@a.DueDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-primary">@a.TotalSubmissions</span></td>
                            <td>
                                <a asp-controller="Teacher" asp-action="ViewSubmissions" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-primary">View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
