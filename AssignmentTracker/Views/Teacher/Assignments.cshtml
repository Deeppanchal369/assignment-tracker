@model List<Assignment>
@{
    ViewData["Title"] = "Assignments";
    int page = (int)(ViewBag.Page ?? 1);
    int totalPages = (int)(ViewBag.TotalPages ?? 1);
    string search = ViewBag.Search as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="mb-0">My Assignments</h4>
    <a asp-controller="Teacher" asp-action="CreateAssignment" class="btn btn-primary">
        <i class="bi bi-plus-circle me-1"></i>Create Assignment
    </a>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form method="get" class="row g-2">
            <div class="col-md-8">
                <input type="text" name="search" value="@search" class="form-control" placeholder="Search by title or subject..." />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100"><i class="bi bi-search me-1"></i>Search</button>
            </div>
            <div class="col-md-2">
                <a asp-controller="Teacher" asp-action="Assignments" class="btn btn-outline-secondary w-100">Reset</a>
            </div>
        </form>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0 align-middle">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Subject</th>
                        <th>Uploaded</th>
                        <th>Due Date</th>
                        <th>Submissions</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No assignments found.</td></tr>
                    }
                    @foreach (var a in Model)
                    {
                        <tr>
                            <td>@a.Title</td>
                            <td>@a.Subject</td>
                            <td>@a.UploadDate.ToString("dd MMM yyyy")</td>
                            <td>@a.DueDate.ToString("dd MMM yyyy")</td>
                            <td><span class="badge bg-primary">@a.TotalSubmissions</span></td>
                            <td class="text-end">
                                <a asp-controller="Teacher" asp-action="ViewAssignment" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-secondary" title="View"><i class="bi bi-eye"></i></a>
                                <a asp-controller="Teacher" asp-action="ViewSubmissions" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-primary" title="Submissions"><i class="bi bi-people"></i></a>
                                <a asp-controller="Teacher" asp-action="EditAssignment" asp-route-id="@a.AssignmentId" class="btn btn-sm btn-outline-warning" title="Edit"><i class="bi bi-pencil"></i></a>
                                <form asp-controller="Teacher" asp-action="DeleteAssignment" asp-route-id="@a.AssignmentId" method="post" class="d-inline" data-confirm="Delete this assignment and all its submissions?">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (totalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination justify-content-center">
            @for (int i = 1; i <= totalPages; i++)
            {
                <li class="page-item @(i == page ? "active" : "")">
                    <a class="page-link" asp-controller="Teacher" asp-action="Assignments" asp-route-page="@i" asp-route-search="@search">@i</a>
                </li>
            }
        </ul>
    </nav>
}
